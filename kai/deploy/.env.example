# KAI Linux Docker 环境变量示例
# 复制为 .env 并填入你的密钥：
#   cp .env.example .env

# DeepSeek API Key（二选一，或都填）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Kimi K3 API Key（Moonshot AI）
KIMI_API_KEY=sk-your-kimi-key-here

# 后端选择：deepseek | kimi
KAI_BACKEND=deepseek

# 运行模式：async | sync | override
KAI_MODE=async

# 时区
TZ=Asia/Shanghai
